! ------------------------------------------------------------------------------
! GLOBAL SETTINGS
! ------------------------------------------------------------------------------

! Render settings for fonts in some X11 apps
Xft.dpi:       96
Xft.antialias: true
Xft.hinting:   true
Xft.rgba:      rgb

! Mouse cursor theme and size
Xcursor.theme: Yaru
Xcursor.size:  24

! ------------------------------------------------------------------------------
! THEME ENGINE (Controlled by dmenu script)
! ------------------------------------------------------------------------------

! This is the only line your script needs to change
#include ".Xresources.d/themes/tokyonight_storm.Xresources"

! Global fallback for the cursor color
*.cursorColor:  #c8c8c8

! ------------------------------------------------------------------------------
! LEGACY FALLBACKS (Optional)
! ------------------------------------------------------------------------------
! Only keep these if you occasionally use a basic terminal like xterm
! as a backup. If not, you can delete everything below this line.

xterm*faceName: Monospace
xterm*faceSize: 11
